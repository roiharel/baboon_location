# Load required libraries
library(leaflet)
library(dplyr)
library(RColorBrewer)
library(ggplot2)

# Define Mpala Research Center coordinates
mpala_center <- c(lon = 36.8333, lat = 0.25)

# Process data: Summarize groups and coordinates at each sleeping site
group_counts <- baboon_sf %>%
    group_by(cluster) %>% # nolint
    summarise(
        num_groups = n_distinct(group_id),
        avg_long = mean(location_long, na.rm = TRUE),
        avg_lat = mean(location_lat, na.rm = TRUE),
        group_names = paste(unique(group_id), collapse = ", ")
    )

# Create interactive map with leaflet
map <- leaflet(data = group_counts) %>%
    addTiles() %>% # nolint: indentation_linter.
    setView(lng = mpala_center["lon"], lat = mpala_center["lat"], zoom = 14) %>%
    addCircleMarkers(
        lng = ~avg_long, lat = ~avg_lat,
        radius = ~sqrt(num_groups) * 4 + 4,   # Adjust circle size based on group count
        color = ~colorNumeric("YlOrRd", num_groups)(num_groups),   # Red color gradient
        stroke = TRUE, fillOpacity = 0.8,
        label = ~paste("Groups:", group_names),   # Display group names
        labelOptions = labelOptions(noHide = TRUE, direction = 'auto', textOnly = TRUE)
    ) %>%
    addLegend("bottomright", pal = colorNumeric("YlOrRd", group_counts$num_groups), 
              values = ~num_groups,
              title = "Number of Groups per Sleeping Site",
              opacity = 0.8) %>%
    addControl("<b>Sleeping Sites of Baboon Groups</b>", position = "topright", className = "map-title")

# Display the interactive map
map

# Create scatter plot for sleeping sites with group names
ggplot(group_counts, aes(x = avg_long, y = avg_lat)) +
    geom_point(aes(size = num_groups, color = num_groups), alpha = 0.7) +
    scale_color_gradient(low = "lightcoral", high = "darkred") +
    geom_text(aes(label = group_names), vjust = -1, size = 3, color = "black") + 
    labs(
        title = "Baboon Sleeping Sites with Group Names",
        x = "Longitude",
        y = "Latitude",
        size = "Number of Groups",
        color = "Number of Groups"
    ) +
    theme_minimal()

# Prepare data for bar plot: Number of sleeping sites per group
site_count_per_group <- baboon_sf %>%
    group_by(group_id, cluster) %>%
    summarise(sleeping_sites = n_distinct(cluster), .groups = "drop")

# Create bar plot for the number of sleeping sites per group
ggplot(site_count_per_group, aes(x = reorder(group_id, -sleeping_sites), y = sleeping_sites, fill = group_id)) +
    geom_bar(stat = "identity") +
    geom_text(aes(label = sleeping_sites), vjust = -0.5, size = 3) + 
    scale_fill_brewer(palette = "Set3") +
    labs(
        title = "Number of Sleeping Sites per Baboon Group",
        x = "Group ID",
        y = "Number of Sleeping Sites"
    ) +
    theme_minimal() +
    theme(axis.text.x = element_text(angle = 45, hjust = 1), legend.position = "none")
